# Supabase URL for Nucleus project. Read directly by
# src/integrations/supabase/client.ts (import.meta.env, frontend
# routes) and src/integrations/supabase/supabaseClient.ts
# (process.env, Guardian/claims backend). Both need this exact name.
VITE_SUPABASE_URL="https://bpqukcsaoporhvdtfyza.supabase.co"

# Supabase anon/publishable key (public client key). Same value under
# two names because the two client files above expect different var
# names for it: client.ts wants VITE_SUPABASE_PUBLISHABLE_KEY,
