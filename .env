# Dev-only auto-login (src/lib/auth-context.tsx). Set both to skip the
# /login form in local dev -- gated on import.meta.env.DEV, so this
# does nothing in a production build even if left set. Requires a real
# Supabase Auth user to already exist in this project (Authentication
# > Users > Add user in the dashboard, or `nucleus` project owner
# tooling) -- these two vars only supply its credentials, they don't
# create the account. Left blank: no such account has been provisioned
# yet. Same convention as dualpay's VITE_DEV_AUTO_LOGIN_EMAIL/PASSWORD.
VITE_DEV_AUTO_LOGIN_EMAIL=""
VITE_DEV_AUTO_LOGIN_PASSWORD=""


# ============================================================
# NUCLEUS RUNTIME CONFIGURATION
# ============================================================

# Organization ID used for local dev
NUCLEUS_ORGANIZATION_ID="org-1"

# Subsystem identifiers
NUCLEUS_SUBSYSTEM_WEAVER="weaver"
NUCLEUS_SUBSYSTEM_GUARDIAN="guardian"
NUCLEUS_SUBSYSTEM_GLUE="glue"
NUCLEUS_SUBSYSTEM_DUALPAY="dualpay"


# ============================================================
# WORKFLOW ENGINE → NUCLEUS WIRING
# ============================================================

# Enable Phase 14 unified execution path
NUCLEUS_WORKFLOW_ADAPTER_ENABLED="true"


# ============================================================
# WORKER RUNTIME CONFIG
# ============================================================

# Number of workers in the pool
NUCLEUS_WORKER_POOL_SIZE="4"

# Durable queue file name
NUCLEUS_QUEUE_FILE="nucleus-queue.json"


# ============================================================
# TELEMETRY + TRACING
# ============================================================

NUCLEUS_TELEMETRY_ENABLED="true"
NUCLEUS_TRACING_ENABLED="true"


# ============================================================
# DECISION ENGINE
# ============================================================

NUCLEUS_DECISION_ENGINE_ENABLED="true"
NUCLEUS_GOVERNANCE_ENABLED="true"
NUCLEUS_CONFIDENCE_MODEL_ENABLED="true"

#=============================================================
# etc
#=============================================================

NUCLEUS_PORT=5151
NUCLEUS_RUNTIME_SUBSYSTEM=weaver
NUCLEUS_ORGANIZATION_ID=org-1
